# Frontend environment (copy to .env.local)
# local  = dummy data + localStorage (default, no backend needed)
# remote = CodeIgniter API under /api/v1
VITE_DATA_SOURCE=local
VITE_API_BASE=/api/v1

# Endpoint backend AI (dipanggil same-origin lewat reverse proxy Apache /ai/)
VITE_AI_URL=/ai/analyze-vehicle

# Auto Scan (deteksi plat lokal sebagai pemicu, bukan OCR)
VITE_AUTO_SCAN_COOLDOWN_MS=10000
VITE_AUTO_SCAN_MAX_UPLOADS=3
VITE_AUTO_SCAN_STABLE_FRAMES=3
# 1 = detektor stub untuk test otomatis
VITE_VISION_STUB=0
